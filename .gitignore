# ─── Free Pascal / Lazarus ───────────────────────────────────────────────────

AGENTS.md

# Compiled units
*.ppu
*.ppw
*.ppa

# Object files
*.o
*.or
*.obj

# Static libraries produced by the linker
*.a
*.so
*.dylib
*.dll

# Executables
*.exe
# macOS application bundles
*.app

# Debug / symbol files
*.dbg
*.gdb
*.dSYM/

# Linker scripts and map files
*.link
*.map
# resource string tables
*.rst
# compiled resources (intermediate)
*.res
# ...except the project resource, which carries MAINICON, the manifest and the
# version info.  It is a build input, not an artifact, and must stay tracked.
!cbzmanager.res
# resource string JSON (fpc >= 3.x)
*.rsj

# FPC crash / bug report dump
fpcdebug.txt

# Throwaway compiler probe files
/ytest.*

# Cross-compilation stamps / target directories
lib/
units/
bin/
obj/
backup/
porting/

# ─── Packaging (makepkg) ─────────────────────────────────────────────────────

# makepkg staging + output; pkg/ itself holds the sources (PKGBUILD, .desktop, .svg)
pkg/pkg/
pkg/src/
pkg/*.pkg.tar.*

# ─── Lazarus IDE ─────────────────────────────────────────────────────────────

# Session / local layout (machine-specific)
*.lps

# Compiled Lazarus package state
*.compiled

# Backup files created by the IDE
*.bak
*.~*
*~

