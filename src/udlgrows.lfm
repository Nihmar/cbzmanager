object dlgRows: TdlgRows
  Left = 400
  Height = 320
  Top = 200
  Width = 500
  BorderIcons = [biSystemMenu]
  BorderStyle = bsDialog
  Caption = 'Delete rows'
  ClientHeight = 320
  ClientWidth = 500
  Position = poScreenCenter
  LCLVersion = '4.8.0.0'
  OnCreate = FormCreate
  object Label1: TLabel
    Left = 12
    Height = 16
    Top = 12
    Width = 476
    Caption = 'Rows to delete (es. 1, 4, 7-10, 15)'
    Font.Height = -13
    Font.Style = [fsBold]
    ParentFont = False
  end
  object EditRanges: TEdit
    Left = 12
    Height = 28
    Top = 32
    Width = 476
    Font.Height = -13
    TabOrder = 0
    Text = ''
    OnChange = EditRangesChange
  end
  object Label2: TLabel
    Left = 12
    Height = 16
    Top = 72
    Width = 476
    Caption = 'Preview'
    Font.Height = -13
    Font.Style = [fsBold]
    ParentFont = False
  end
  object PanelPreview: TPanel
    Left = 12
    Height = 60
    Top = 92
    Width = 476
    Align = alCustom
    BevelOuter = bvLowered
    TabOrder = 1
    object LblPreview: TLabel
      Left = 8
      Height = 44
      Top = 8
      Width = 460
      Align = alCustom
      Caption = 'No pages selected'
      Layout = tlCenter
      WordWrap = True
    end
  end
  object CbRenumber: TCheckBox
    Left = 12
    Height = 24
    Top = 168
    Width = 476
    Caption = 'Renumber remaining pages'
    Checked = True
    State = cbChecked
    TabOrder = 2
  end
  object CbRemoveComicInfo: TCheckBox
    Left = 12
    Height = 24
    Top = 196
    Width = 476
    Caption = 'Remove ComicInfo.xml'
    Checked = True
    State = cbChecked
    TabOrder = 3
  end
  object PanelBottom: TPanel
    Left = 0
    Height = 48
    Top = 272
    Width = 500
    Align = alBottom
    BevelOuter = bvNone
    ClientHeight = 48
    ClientWidth = 500
    TabOrder = 4
    object BtnOk: TButton
      Left = 324
      Height = 30
      Top = 9
      Width = 80
      Caption = 'Delete'
      Default = True
      ModalResult = mrOk
      TabOrder = 0
    end
    object BtnCancel: TButton
      Left = 412
      Height = 30
      Top = 9
      Width = 80
      Cancel = True
      Caption = 'Cancel'
      ModalResult = mrCancel
      TabOrder = 1
    end
  end
end
