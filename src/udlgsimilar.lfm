    RowSelect = True
    TabOrder = 1
    ViewStyle = vsReport
  end
  object PanelBottom: TPanel
    Left = 0
    Height = 44
    Top = 436
    Width = 720
    Align = alBottom
    BevelOuter = bvNone
    ClientHeight = 44
    ClientWidth = 720
    TabOrder = 2
    object BtnExtract: TButton
      Left = 456
      Height = 30
      Top = 7
      Width = 120
      Caption = 'Extract to folder...'
      TabOrder = 0
    end
    object BtnDeleteDups: TButton
      Left = 584
      Height = 30
      Top = 7
      Width = 120
      Caption = 'Delete duplicates'
      TabOrder = 1
    end
    object BtnClose: TButton
      Left = 12
      Height = 30
      Top = 7
      Width = 80
      Cancel = True
      Caption = 'Close'
